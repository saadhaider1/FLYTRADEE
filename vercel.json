{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build",
    "installCommand": "npm install",
    "outputDirectory": "frontend/build",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "includeFiles": "backend/**"
        }
    }
}